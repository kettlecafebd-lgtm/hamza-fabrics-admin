VITE_API_URL=http://localhost:5000
VITE_GTM_CONTAINER_ID=GTM-XXXXXXX
VITE_SITE_NAME=Hamza Fabrics
VITE_SITE_DESCRIPTION=Premium Unstitched Fabrics
VITE_CONTACT_EMAIL=contact@hamzafabrics.com
VITE_CONTACT_PHONE=+8801700000000
VITE_ADDRESS=Dhaka, Bangladesh
VITE_CURRENCY=BDT
VITE_DELIVERY_INSIDE=80
VITE_DELIVERY_OUTSIDE=150
VITE_FREE_DELIVERY_MIN=3

# ---- Media delivery (Cloudflare R2) --------------------------------------
# Public base of the R2 bucket (custom domain, or the bucket's r2.dev URL).
# Must match the backend's R2_PUBLIC_BASE_URL.
VITE_MEDIA_PUBLIC_BASE_URL=https://media.hamzafabrics.com
# Ask Cloudflare's edge for a downscaled thumbnail instead of the original:
#   <base>/products/a.webp -> <base>/cdn-cgi/image/width=96,quality=70,format=auto/products/a.webp
# Requires an Image Resizing rule for the zone. Off = full-size originals.
VITE_CDN_IMAGE_TRANSFORMS=false
# LEGACY: Supabase Storage transforms. Leave off; only for objects still served
# from <project>.supabase.co while the migration drains.
VITE_SUPABASE_IMAGE_TRANSFORMS=false
