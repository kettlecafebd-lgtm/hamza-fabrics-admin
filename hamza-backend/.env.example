# ---- Supabase (required) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Meta / Facebook (required for Messenger + Instagram) ----
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# ---- WhatsApp Cloud API (server-side only; used for replies and media) ----
# Token for the connected WhatsApp business number with whatsapp_business_messaging.
# Not the webhook verify token or a Facebook Page token. Never put in VITE_*.
WHATSAPP_TOKEN=
# Meta's phone number ID (not the phone number). Must match the inbound thread.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- Optional QR / Linked Devices reply sync (server-side only) ----
# Dedicated random shared secret for the existing bridge + this API only.
# Empty disables POST /api/bridge/whatsapp/replies. Apply migration 004 first.
WHATSAPP_BRIDGE_SECRET=
# Match the page_id on this linked account's existing inbound conversations.
# Empty matches NULL only; it does not grant access to every business number.
WHATSAPP_BRIDGE_PAGE_ID=

# ---- Media URLs ----
# Dedicated HMAC secret for signed /api/chat/media/s/:token links.
# Optional; derived from the service-role key when unset (not ideal: rotating
# DB credentials would then invalidate every outstanding media link).
MEDIA_URL_SIGNING_SECRET=
# Absolute base for media links (leave empty to emit root-relative paths
# so the same value works behind nginx / a Vercel rewrite).
PUBLIC_API_BASE_URL=

# ---- Cloudflare R2 (the media store) --------------------------------------
# Supabase Storage is DEPRECATED. Product images, hero banners, variant photos,
# review images and avatars are written to R2 and served from R2_PUBLIC_BASE_URL,
# so neither Supabase egress nor Supabase Storage log ingestion is involved.
#
# Create the bucket + an S3 API token in the Cloudflare dashboard:
#   R2 > Manage R2 API Tokens > Create API token (Object Read & Write)
# The endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com (derived below
# from R2_ACCOUNT_ID unless you set R2_ENDPOINT explicitly).
R2_BUCKET=hamza-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
# Optional full endpoint override (leave empty to derive from R2_ACCOUNT_ID).
R2_ENDPOINT=
R2_REGION=auto
# Public delivery base: a custom domain in front of the bucket (recommended,
# e.g. https://media.hamzafabrics.com) or the bucket's r2.dev URL.
# Leave empty and public URLs cannot be generated.
R2_PUBLIC_BASE_URL=https://media.hamzafabrics.com

# 'r2' (default once the credentials above exist) or 'supabase'.
# Set 'supabase' only to drain/delete objects in an existing Supabase bucket --
# that driver cannot store new media on purpose.
MEDIA_STORAGE_DRIVER=

# Presigned browser uploads: the browser PUTs straight to R2, so zero bytes
# transit this backend. Requires a bucket CORS rule allowing PUT from the admin
# origin. Set false to force the multipart fallback below while CORS is pending.
MEDIA_DIRECT_UPLOAD_ENABLED=true
MEDIA_PRESIGN_TTL_SECONDS=300
MEDIA_UPLOAD_MAX_BYTES=10485760

# ---- Product / hero media life-cycle (POST /api/media/*) ----
# Deletion stays inert until this is true. Run migrations/003_media_references.sql
# first and verify the view: anything it cannot see is never deleted.
MEDIA_DELETE_ENABLED=false
# Comma-separated Supabase Storage buckets the delete/backfill routes may touch.
MEDIA_DELETE_BUCKETS=media,products
# Bound on work per request (the browser sweep sends batches of <= 50).
MEDIA_DELETE_MAX_URLS=50
# Cache-Control backfill: on R2 this is a server-side CopyObject (metadata only,
# no payload egress), so batches can be larger than the old Supabase round-trip.
MEDIA_CACHE_CONTROL_MAX_URLS=10
MEDIA_CACHE_CONTROL_MAX_BYTES=26214400
# Seconds stored on upload; served as `Cache-Control: public, max-age=<n>, immutable`.
MEDIA_UPLOAD_CACHE_CONTROL_SECONDS=31536000
MEDIA_REFERENCES_VIEW=media_references

# ---- Logging (Supabase log ingestion is billed per line) ----
# debug floods ingestion and is refused in production; silent hides failures.
LOG_LEVEL=info
# One line per stored chat message. Off by default: it was the single largest
# log-ingestion driver in this service.
LOG_MEDIA_EVENTS=false
# One line per HTTP request, skipping /api/chat/media/* and probes. Failures
# always log; successes only at debug.
LOG_HTTP_REQUESTS=false

# ---- Tuning ----
PORT=5000
MEDIA_URL_TTL_SECONDS=259200
MEDIA_STREAM_MAX_BYTES=16777216
MEDIA_STREAM_CACHE_BYTES=33554432
BLOB_BREAKER_SECONDS=60
MEDIA_URL_SIGNING_TTL_SECONDS=86400

# ---- DANGER ----
# Do NOT enable. Binary chat attachment storage is what caused the 106 MB TOAST
# and 36 GB egress incident. Defaults to false; only for debugging a migration.
ENABLE_LEGACY_BLOB_WRITES=false
