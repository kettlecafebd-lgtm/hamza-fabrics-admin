# ---- Supabase (required) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Meta / Facebook (required for Messenger + Instagram) ----
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# ---- WhatsApp Cloud API (required for WhatsApp media) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- Media URLs ----
# Dedicated HMAC secret for signed /api/chat/media/s/:token links.
# Optional; derived from the service-role key when unset (not ideal: rotating
# DB credentials would then invalidate every outstanding media link).
MEDIA_URL_SIGNING_SECRET=
# Absolute base for media links (leave empty to emit root-relative paths
# so the same value works behind nginx / a Vercel rewrite).
PUBLIC_API_BASE_URL=

# ---- Product / hero media life-cycle (POST /api/media/*) ----
# Deletion stays inert until this is true. Run migrations/003_media_references.sql
# first and verify the view: anything it cannot see is never deleted.
MEDIA_DELETE_ENABLED=false
# Comma-separated Supabase Storage buckets the delete/backfill routes may touch.
MEDIA_DELETE_BUCKETS=media,products
# Bound on work per request (the browser sweep sends batches of <= 50).
MEDIA_DELETE_MAX_URLS=50
# Cache-Control backfill re-uploads bytes, so keep batches and object size small.
MEDIA_CACHE_CONTROL_MAX_URLS=10
MEDIA_CACHE_CONTROL_MAX_BYTES=8388608
# Supabase stores seconds and serves `Cache-Control: max-age=<n>`.
MEDIA_UPLOAD_CACHE_CONTROL_SECONDS=31536000
MEDIA_REFERENCES_VIEW=media_references

# ---- Tuning ----
PORT=5000
LOG_LEVEL=info
MEDIA_URL_TTL_SECONDS=259200
MEDIA_STREAM_MAX_BYTES=16777216
MEDIA_STREAM_CACHE_BYTES=33554432
BLOB_BREAKER_SECONDS=60
MEDIA_URL_SIGNING_TTL_SECONDS=86400

# ---- DANGER ----
# Do NOT enable. Binary chat attachment storage is what caused the 106 MB TOAST
# and 36 GB egress incident. Defaults to false; only for debugging a migration.
ENABLE_LEGACY_BLOB_WRITES=false
