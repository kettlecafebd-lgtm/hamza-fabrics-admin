    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@supabase/supabase-js": "^2.45.4",
    "express": "^4.21.2"
  }
}
